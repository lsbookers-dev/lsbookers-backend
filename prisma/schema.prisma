generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────

enum Role {
  ARTIST
  ORGANIZER
  PROVIDER
  ADMIN
}

enum LegalStatus {
  INDIVIDUAL        // Particulier
  AUTO_ENTREPRENEUR // Auto-entrepreneur
  COMPANY           // Societe
}

enum OrganizerType {
  INDIVIDUAL    // Particulier (soiree privee)
  PROFESSIONAL  // Professionnel (club, festival, societe)
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MessageFileType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum OfferType {
  ARTIST
  PROVIDER
  ALL
}

enum OfferStatus {
  ACTIVE
  CLOSED
}

enum ApplicationStatus {
  PENDING   // En attente de reponse
  ACCEPTED  // Acceptee par l'organisateur
  REJECTED  // Refusee
}

enum ContractStatus {
  PENDING   // Envoye, en attente de signature
  SIGNED    // Signe par les deux parties
  REJECTED  // Refuse
  CANCELLED // Annule
}

enum PaymentStatus {
  PENDING       // En attente
  DEPOSIT_PAID  // Acompte paye
  COMPLETED     // Paiement complet
  REFUNDED      // Rembourse
  FAILED        // Echec
}

enum SubscriptionStatus {
  TRIAL     // Periode d'essai
  ACTIVE    // Abonnement actif
  CANCELLED // Annule
  EXPIRED   // Expire
}

enum EventStatus {
  DRAFT      // Brouillon (non visible)
  PUBLISHED  // Visible publiquement
  CANCELLED  // Annule
  COMPLETED  // Termine
}

enum AvailabilityStatus {
  AVAILABLE    // Disponible
  UNAVAILABLE  // Indisponible
  BOOKED       // Déjà booké
  TENTATIVE    // En attente de confirmation
}

enum BookingStatus {
  PENDING    // En attente de réponse
  ACCEPTED   // Acceptée
  DECLINED   // Refusée
  CANCELLED  // Annulée
  COMPLETED  // Terminée
}

enum StaffStatus {
  NEEDED    // Poste a pourvoir
  BOOKED    // Personne confirmee
  CANCELLED // Annule
}

// ─────────────────────────────────────────────
//  USER & PROFILE
// ─────────────────────────────────────────────

model User {
  id                  Int                      @id @default(autoincrement())
  // Identifiants
  email               String                   @unique
  password            String
  role                Role
  isAdmin             Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  lastActiveAt        DateTime?

  // Identite (collectee a l'etape 2 de l'inscription)
  pseudo              String?                  @unique
  firstName           String?
  lastName            String?
  dateOfBirth         DateTime?
  phone               String?
  countryOfResidence  String?

  // Verification email
  emailVerified           Boolean   @default(false)
  emailVerificationToken  String?   @unique

  // Paiements Stripe (actives uniquement lors de la premiere transaction)
  stripeAccountId     String?                  // ID Stripe Connect
  isIdentityVerified  Boolean                  @default(false)
  isPaymentEnabled    Boolean                  @default(false)

  // Etapes d'inscription completes
  registrationStep    Int                      @default(1) // 1=compte, 2=identite, 3=profil, 4=paiement

  profile             Profile?
  media               Media[]
  followers           Follow[]                 @relation("followers")
  following           Follow[]                 @relation("following")
  blocking            Block[]                  @relation("blocking")
  blockedBy           Block[]                  @relation("blockedBy")
  messages            Message[]                @relation("SentMessages")
  conversations       ConversationParticipant[]
  notifications       Notification[]
  notificationsSent   Notification[]           @relation("NotificationActor")
  passwordResets      PasswordReset[]
  subscription        Subscription?
  loginEvents         LoginEvent[]
}

model Profile {
  id                      Int                      @id @default(autoincrement())
  userId                  Int                      @unique

  // Infos publiques (visibles sur le profil)
  bio                     String?
  profession              String?
  location                String?
  country                 String?
  latitude                Float?
  longitude               Float?
  radiusKm                Int?
  specialties             String[]
  typeEtablissement       String?
  avatar                  String?
  banner                  String?
  soundcloudUrl           String?
  showSoundcloud          Boolean                  @default(false)
  showStyles              Boolean                  @default(true)
  youtubeUrl              String?                  // Lien vidéo de prestation (YouTube/Vimeo)
  showYoutubeUrl          Boolean                  @default(true)
  instagramUrl            String?
  facebookUrl             String?
  tiktokUrl               String?
  twitterUrl              String?
  linkedinUrl             String?
  websiteUrl              String?
  cvText                  String?   // CV / expérience (artistes)
  feeInfo                 String?   // Tarifs / info cachets (artistes)
  styles                  String[]                 // Styles artistiques (RNB, Electro, Jazz...)
  availableForBooking     Boolean                  @default(true)   // Disponible pour booking
  showRealName            Boolean                  @default(false)  // Afficher nom/prénom au lieu du pseudo

  // Infos legales (non visibles sur le profil, usage interne)
  legalStatus             LegalStatus?             // Particulier / Auto-entrepreneur / Societe
  siret                   String?                  // Numero SIRET ou KBIS
  organizerType           OrganizerType?           // Pour les organisateurs : particulier ou professionnel
  establishmentName       String?                  // Nom de l'etablissement (organisateurs pro)
  address                 String?                  // Adresse postale complete
  postalCode              String?
  city                    String?

  user                    User                     @relation(fields: [userId], references: [id])
  notificationPreferences NotificationPreferences?
  events                  Event[]
  media                   Media[]
  publications            Publication[]
  offers                  Offer[]
  albums                  Album[]

  // Candidatures soumises (artiste/prestataire qui postule)
  applicationsSubmitted   Application[]            @relation("ApplicationApplicant")

  // Contrats
  contractsSent           Contract[]               @relation("ContractSender")
  contractsReceived       Contract[]               @relation("ContractRecipient")

  // Paiements
  paymentsMade            Payment[]                @relation("PaymentPayer")
  paymentsReceived        Payment[]                @relation("PaymentRecipient")

  // Avis
  reviewsGiven            Review[]                 @relation("ReviewAuthor")
  reviewsReceived         Review[]                 @relation("ReviewTarget")

  // Staff d'evenements
  eventStaffAssignments   EventStaff[]

  // Likes & Commentaires
  publicationLikes        PublicationLike[]
  publicationComments     PublicationComment[]
  commentLikes            PublicationCommentLike[]

  // Agenda
  availability            Availability[]
  bookingRequestsSent     BookingRequest[] @relation("BookingRequester")
  bookingRequestsReceived BookingRequest[] @relation("BookingTarget")
}

// ─────────────────────────────────────────────
//  PUBLICATIONS
// ─────────────────────────────────────────────

model Publication {
  id        Int                  @id @default(autoincrement())
  title     String
  media     String
  mediaType String
  caption   String?
  profileId Int
  createdAt DateTime             @default(now())

  profile         Profile              @relation(fields: [profileId], references: [id])
  likes           PublicationLike[]
  comments        PublicationComment[]
  notifications   Notification[]
  additionalMedia PublicationMedia[]
  albumItems      AlbumItem[]
}

model PublicationLike {
  id            Int         @id @default(autoincrement())
  publicationId Int
  profileId     Int
  createdAt     DateTime    @default(now())

  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  profile       Profile     @relation(fields: [profileId], references: [id])

  @@unique([publicationId, profileId]) // Un seul like par personne par publication
}

model PublicationComment {
  id            Int         @id @default(autoincrement())
  content       String
  publicationId Int
  profileId     Int
  createdAt     DateTime    @default(now())
  parentId      Int?

  publication   Publication          @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  profile       Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parent        PublicationComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       PublicationComment[] @relation("CommentReplies")
  likes         PublicationCommentLike[]

  @@index([publicationId])
  @@index([profileId])
  @@index([parentId])
}

model PublicationCommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int
  profileId Int
  createdAt DateTime @default(now())

  comment   PublicationComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([commentId, profileId])
  @@index([commentId])
  @@index([profileId])
}

// ─────────────────────────────────────────────
//  MÉDIAS MULTIPLES PAR PUBLICATION
// ─────────────────────────────────────────────

model PublicationMedia {
  id            Int         @id @default(autoincrement())
  publicationId Int
  url           String
  mediaType     String      @default("image") // image | video
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId])
}

// ─────────────────────────────────────────────
//  ALBUMS
// ─────────────────────────────────────────────

model Album {
  id          Int         @id @default(autoincrement())
  profileId   Int
  title       String
  description String?
  coverUrl    String?     // URL de couverture personnalisée (null = 1ère image auto)
  isPrivate   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items       AlbumItem[]

  @@index([profileId])
}

model AlbumItem {
  id            Int          @id @default(autoincrement())
  albumId       Int
  publicationId Int?         // Lien vers une publication existante (optionnel)
  mediaUrl      String?      // Média direct (sans publication)
  mediaType     String?      // image | video
  caption       String?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())

  album         Album        @relation(fields: [albumId], references: [id], onDelete: Cascade)
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([albumId])
}

// ─────────────────────────────────────────────
//  MEDIA
// ─────────────────────────────────────────────

model Media {
  id        Int       @id @default(autoincrement())
  url       String
  type      MediaType
  caption   String?
  createdAt DateTime  @default(now())
  userId    Int
  profileId Int

  user      User      @relation(fields: [userId], references: [id])
  profile   Profile   @relation(fields: [profileId], references: [id])
}

// ─────────────────────────────────────────────
//  FOLLOW
// ─────────────────────────────────────────────

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower    User     @relation("followers", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker   User     @relation("blocking", fields: [blockerId], references: [id])
  blocked   User     @relation("blockedBy", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

// ─────────────────────────────────────────────
//  MESSAGERIE
// ─────────────────────────────────────────────

model Conversation {
  id           Int                      @id @default(autoincrement())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int

  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
}

model Message {
  id                 Int              @id @default(autoincrement())
  content            String?
  attachmentUrl      String?
  attachmentType     MessageFileType?
  attachmentName     String?
  attachmentMimeType String?
  senderId           Int
  conversationId     Int
  seen               Boolean          @default(false)
  seenAt             DateTime?
  createdAt          DateTime         @default(now())
  type               String           @default("TEXT")  // TEXT | BOOKING_REQUEST
  bookingRequestId   Int?

  sender             User             @relation("SentMessages", fields: [senderId], references: [id])
  conversation       Conversation     @relation(fields: [conversationId], references: [id])
  bookingRequest     BookingRequest?  @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  notifications      Notification[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([seen])
}

// ─────────────────────────────────────────────
//  EVENEMENTS (AGENDA)
// ─────────────────────────────────────────────

model Event {
  id           Int         @id @default(autoincrement())
  title        String
  description  String?
  notes        String?                      // Notes privées de l'organisateur
  start        DateTime
  end          DateTime?
  allDay       Boolean     @default(false)
  lieu         String?
  category     String?                      // Ex: "Club", "Mariage", "Corporate"
  coverImage   String?                      // URL image de couverture (événement public)
  isPrivate    Boolean     @default(false)  // Privé = visible seulement par l'organisateur
  budget       Float?                       // Budget total
  maxCapacity  Int?                         // Capacité max
  status       EventStatus @default(DRAFT)
  profileId    Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  profile          Profile          @relation(fields: [profileId], references: [id])
  staff            EventStaff[]
  contracts        Contract[]
  reviews          Review[]
  documents        EventDocument[]
  bookingRequests  BookingRequest[]
  expenses         EventExpense[]
  purchases        EventPurchase[]
  offers           Offer[]

  @@index([profileId])
  @@index([start])
}

// Dépenses / frais d'un événement
model EventExpense {
  id        Int      @id @default(autoincrement())
  eventId   Int
  label     String
  amount    Float?
  category  String?  // "Technique", "Catering", "Décor", "Communication", "Autre"
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Liste d'achats à effectuer pour un événement
model EventPurchase {
  id        Int      @id @default(autoincrement())
  eventId   Int
  item      String
  quantity  Int?
  price     Float?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Documents liés à un événement (contrats, factures, riders...)
model EventDocument {
  id        Int      @id @default(autoincrement())
  eventId   Int
  name      String
  url       String
  fileType  String?  // "contract", "invoice", "rider", "other"
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// Disponibilités d'un artiste ou prestataire
model Availability {
  id        Int                @id @default(autoincrement())
  profileId Int
  date      DateTime           // Jour concerné (heure ignorée)
  status    AvailabilityStatus @default(AVAILABLE)
  note      String?
  createdAt DateTime           @default(now())

  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, date])
  @@index([profileId])
}

// Demandes de réservation / booking
model BookingRequest {
  id          Int           @id @default(autoincrement())
  requesterId Int           // Profil qui fait la demande (organisateur)
  targetId    Int           // Profil ciblé (artiste/prestataire)
  eventId     Int?          // Événement lié (optionnel)
  startDate   DateTime
  endDate     DateTime?
  message     String?
  fee                     Float?        // Cachet proposé
  status                  BookingStatus @default(PENDING)
  paymentStatus           String        @default("UNPAID")  // UNPAID | DEPOSIT | PAID
  cancellationRequestedBy Int?          // Profile ID qui demande l'annulation
  cancellationNote        String?       // Raison optionnelle
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  requester   Profile       @relation("BookingRequester", fields: [requesterId], references: [id])
  target      Profile       @relation("BookingTarget", fields: [targetId], references: [id])
  event       Event?        @relation(fields: [eventId], references: [id])
  messages    Message[]

  @@index([requesterId])
  @@index([targetId])
}

// Postes requis dans un evenement prive
model EventStaff {
  id         Int         @id @default(autoincrement())
  eventId    Int
  role       String      // Ex: "DJ", "Traiteur", "Photographe"
  count      Int         @default(1)
  notes      String?
  fee        Float?      // Cachet prevu pour ce poste
  status     StaffStatus @default(NEEDED)
  profileId  Int?        // Personne assignee (null si pas encore pourvu)
  createdAt  DateTime    @default(now())

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile    Profile?    @relation(fields: [profileId], references: [id])
  contract   Contract?

  @@index([eventId])
}

// ─────────────────────────────────────────────
//  OFFRES D'EMPLOI & CANDIDATURES
// ─────────────────────────────────────────────

model Offer {
  id            Int           @id @default(autoincrement())
  title         String
  description   String
  type          OfferType
  specialty     String?
  date          DateTime
  endDate       DateTime?     // Date de fin (optionnel)
  location      String
  country       String
  radiusKm      Int?
  fee           Float?        // Tarif proposé (optionnel)
  eventId       Int?          // Événement lié (optionnel)
  status        OfferStatus   @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  organizerId   Int

  organizer     Profile       @relation(fields: [organizerId], references: [id])
  event         Event?        @relation(fields: [eventId], references: [id])
  applications  Application[]
  notifications Notification[]

  @@index([type])
  @@index([createdAt])
}

model Application {
  id          Int               @id @default(autoincrement())
  offerId     Int
  applicantId Int               // Profile ID de l'artiste/prestataire
  message     String?           // Message de motivation
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  offer       Offer             @relation(fields: [offerId], references: [id])
  applicant   Profile           @relation("ApplicationApplicant", fields: [applicantId], references: [id])

  @@unique([offerId, applicantId]) // Pas de double candidature
  @@index([offerId])
  @@index([applicantId])
}

// ─────────────────────────────────────────────
//  CONTRATS
// ─────────────────────────────────────────────

model Contract {
  id          Int            @id @default(autoincrement())
  title       String
  fileUrl     String         // URL du fichier PDF
  amount      Float?         // Montant du contrat
  status      ContractStatus @default(PENDING)
  senderId    Int
  recipientId Int
  eventId     Int?
  staffId     Int?           @unique
  signedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sender      Profile        @relation("ContractSender", fields: [senderId], references: [id])
  recipient   Profile        @relation("ContractRecipient", fields: [recipientId], references: [id])
  event       Event?         @relation(fields: [eventId], references: [id])
  staff       EventStaff?    @relation(fields: [staffId], references: [id])
  payments    Payment[]

  @@index([senderId])
  @@index([recipientId])
}

// ─────────────────────────────────────────────
//  PAIEMENTS
// ─────────────────────────────────────────────

model Payment {
  id           Int           @id @default(autoincrement())
  amount       Float         // Montant total en euros
  deposit      Float?        // Montant de l'acompte
  commission   Float?        // Commission LSBookers
  currency     String        @default("EUR")
  status       PaymentStatus @default(PENDING)
  stripeId     String?       // ID Stripe
  payerId      Int
  recipientId  Int
  contractId   Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payer        Profile       @relation("PaymentPayer", fields: [payerId], references: [id])
  recipient    Profile       @relation("PaymentRecipient", fields: [recipientId], references: [id])
  contract     Contract?     @relation(fields: [contractId], references: [id])

  @@index([payerId])
  @@index([recipientId])
}

// ─────────────────────────────────────────────
//  AVIS
// ─────────────────────────────────────────────

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // Note de 1 a 5
  comment   String?
  authorId  Int      // Qui ecrit l'avis
  targetId  Int      // Qui est note
  eventId   Int?     // Lien vers l'evenement (optionnel)
  createdAt DateTime @default(now())

  author    Profile  @relation("ReviewAuthor", fields: [authorId], references: [id])
  target    Profile  @relation("ReviewTarget", fields: [targetId], references: [id])
  event     Event?   @relation(fields: [eventId], references: [id])

  @@unique([authorId, targetId, eventId])
  @@index([targetId])
}

// ─────────────────────────────────────────────
//  ABONNEMENTS
// ─────────────────────────────────────────────

model Subscription {
  id          Int                @id @default(autoincrement())
  userId      Int                @unique
  status      SubscriptionStatus @default(TRIAL)
  plan        String             @default("MONTHLY")
  priceCents  Int                @default(1000) // 10 euros en centimes
  stripeSubId String?            // ID abonnement Stripe
  startDate   DateTime           @default(now())
  endDate     DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user        User               @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
//  NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id            Int      @id @default(autoincrement())
  userId        Int
  type          String
  content       String?
  legacyMessage String?  @map("message")
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  offerId   Int?
  offer     Offer?   @relation(fields: [offerId], references: [id])
  actorId   Int?
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id])
  messageId     Int?
  message       Message?     @relation(fields: [messageId], references: [id])
  publicationId Int?
  publication   Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
}

model NotificationPreferences {
  id            Int     @id @default(autoincrement())
  profileId     Int     @unique
  locationScope String  @default("INTERNATIONAL")

  profile       Profile @relation(fields: [profileId], references: [id])
}

// ─────────────────────────────────────────────
//  ADMIN
// ─────────────────────────────────────────────

model AdminSettings {
  id             Int      @id @default(1)
  mainColor      String?  @default("#FF0055")
  secondaryColor String?  @default("#000000")
  bannerUrl      String?
  logoUrl        String?
  welcomeText    String?
  landingBgUrl   String?
  loginBgUrl     String?
  registerBgUrl  String?
  headerLogoUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  CONTACT
// ─────────────────────────────────────────────

model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  subject    String?
  message    String
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([isArchived])
}

// ─────────────────────────────────────────────
//  AUTH
// ─────────────────────────────────────────────

model PasswordReset {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
//  TRACKING CONNEXIONS
// ─────────────────────────────────────────────

model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model AdminPost {
  id        Int        @id @default(autoincrement())
  title     String?
  content   String?
  mediaUrl  String?
  mediaType MediaType?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
